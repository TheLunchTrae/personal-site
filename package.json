{
  "name": "personal-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "audit": "bun audit --audit-level=low",
    "build": "next build",
    "dev": "next dev",
    "directives:check": "bun run scripts/check-directives.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "lint": "bun run directives:check && oxlint .",
    "lint:fix": "bun run directives:check && oxlint --fix .",
    "standards": "bun run lint:fix && bun run format",
    "test": "bun test",
    "typecheck": "tsc --pretty -p tsconfig.json",
    "typegen": "next typegen"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint-plugin-regexp": "3.3.1",
    "knip": "6.43.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
